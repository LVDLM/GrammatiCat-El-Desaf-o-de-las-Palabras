rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function incoming() { 
      return request.resource.data; 
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }

    // Rules for Leaderboard
    match /leaderboard/{entryId} {
      allow read: if true;
      allow create: if (
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 50 &&
        incoming().score is number && incoming().score >= 0 && incoming().score <= 10000000 &&
        incoming().created_at is string
      );
      allow update, delete: if false;
    }

    // Rules for Community Levels
    match /levels/{levelId} {
      allow read: if true;
      allow create: if (
        incoming().id is number &&
        incoming().title is string && incoming().title.size() <= 200 &&
        incoming().text is string && incoming().text.size() <= 5000 &&
        incoming().words is list && incoming().words.size() > 0 &&
        incoming().timeLimit is number && incoming().timeLimit >= 10 && incoming().timeLimit <= 600 &&
        incoming().categoryGroup is string &&
        incoming().created_at is string
      );
      allow update, delete: if false;
    }
  }
}
